<?xml version="1.0" encoding="UTF-8" ?>
<!-- 隐藏彩蛋页：只能通过「关于」对话框连点应用 Logo 7 次进入，不会出现在主页菜单 -->
<nav title="彩蛋">
    <resource file="file:///android_asset/kr-script/egg/egg_fun.sh" />

    <group title="🥚 隐藏彩蛋">
        <summary>恭喜你发现了隐藏入口！这里收集了一些非主流的玩机小工具，仅供娱乐与研究</summary>

        <action title="设备冷知识" interruptible="true">
            <desc>随机展示一条关于你设备的冷知识（型号、Android 版本、内核、ROOT 环境等）</desc>
            <set>sh "$START_DIR/kr-script/egg/egg_fun.sh" info</set>
        </action>

        <action title="今天的幸运色" interruptible="true">
            <desc>根据日期随机生成一个今天的「幸运主题色」并输出其 HEX 值，纯属娱乐</desc>
            <set>sh "$START_DIR/kr-script/egg/egg_fun.sh" lucky</set>
        </action>
    </group>

    <group title="电源 / 重启">
        <resource dir="file:///android_asset/kr-script/slot" />
        <summary>高危操作集合，请确认已获得 Root 权限并清楚后果后再执行</summary>

        <action title="关机" auto-off="true" confirm="true">
            <desc>立即关机（需 Root）</desc>
            <set>/system/bin/reboot -p</set>
        </action>

        <action title="重启" auto-off="true" confirm="true">
            <desc>正常重启（需 Root）</desc>
            <set>/system/bin/reboot</set>
        </action>

        <action title="软重启" auto-off="true" confirm="true">
            <desc>仅重启 Android 用户空间（Zygote），不重启内核</desc>
            <set>setprop ctl.restart zygote</set>
        </action>

        <action title="重启到 Recovery" auto-off="true" confirm="true">
            <desc>重启进入 Recovery 模式（需 Root）</desc>
            <set>/system/bin/reboot recovery</set>
        </action>

        <action title="重启到 Bootloader" auto-off="true" confirm="true">
            <desc>重启进入 Bootloader（需 Root）</desc>
            <set>/system/bin/reboot bootloader</set>
        </action>

        <action title="重启到 Download" auto-off="true" confirm="true">
            <desc>重启进入 Download 模式（需 Root）</desc>
            <set>/system/bin/reboot download</set>
        </action>

        <action title="重启到 EDL" auto-off="true" confirm="true">
            <desc>重启进入 EDL 9008 模式（需 Root）</desc>
            <set>/system/bin/reboot edl</set>
        </action>

        <action title="重启到 Fastbootd" auto-off="true" confirm="true">
            <desc>重启进入 Fastbootd（需 Root）</desc>
            <set>/system/bin/reboot fastboot</set>
        </action>

        <action title="重启到另一卡槽" auto-off="true" confirm="true">
            <desc>切换到另一个 A/B 槽位并重启（需 Root）</desc>
            <set>sh "$START_DIR/kr-script/slot/swab.sh" -o -r</set>
        </action>
    </group>

    <group title="模块仓库">
        <page html="file:///android_asset/scene_magisk_repo.html" title="Scene Magisk 模块仓库">
            <desc>内置网页浏览器打开 Scene Magisk 模块仓库，可搜索、查看模块详情与下载（联网使用）</desc>
        </page>
    </group>

    <group title="GT 玩机助手 OTA">
        <page config="../payload/payload.xml" title="GT 强制安装 OTA 包">
            <desc>通过 fastbootd 强制刷入官方 OTA 包（payload.bin）。需解锁 bootloader 并已进入 fastbootd 模式</desc>
            <resource dir="file:///android_asset/kr-script/payload" />
        </page>
    </group>
</nav>
