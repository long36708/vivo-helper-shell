<?xml version="1.0" encoding="UTF-8" ?>
<nav title="主页">
    <resource file="file:///android_asset/kr-script/slot/swab.sh" />
    <resource file="file:///android_asset/kr-script/clock/toggle_clock_seconds.sh" />
    <resource file="file:///android_asset/kr-script/toolkit/device_status.sh" />
    <resource file="file:///android_asset/kr-script/toolkit/extra_dim.sh" />

    <menu>
        <option type="default" id="1" auto-off="true" shell="hidden" confirm="true">关机</option>
        <option type="default" id="9" auto-off="true" shell="hidden" confirm="true">重启</option>
        <option type="default" id="2" auto-off="true" shell="hidden" confirm="true">软重启</option>
        <option type="default" id="3" auto-off="true" shell="hidden" confirm="true">重启到 Recovery</option>
        <option type="default" id="4" auto-off="true" shell="hidden" confirm="true">重启到 Bootloader</option>
        <option type="default" id="5" auto-off="true" shell="hidden" confirm="true">重启到 Download</option>
        <option type="default" id="6" auto-off="true" shell="hidden" confirm="true">重启到 EDL</option>
        <option type="default" id="7" auto-off="true" shell="hidden" confirm="true">重启到 Fastbootd</option>
        <option type="default" id="8" auto-off="true" shell="hidden" confirm="true">重启到另一卡槽</option>
        <handler>
            case "$menu_id" in
            1)
            /system/bin/reboot -p
            ;;
            2)
            setprop ctl.restart zygote
            ;;
            3)
            /system/bin/reboot recovery
            ;;
            4)
            /system/bin/reboot bootloader
            ;;
            5)
            /system/bin/reboot download
            ;;
            6)
            /system/bin/reboot edl
            ;;
            7)
            /system/bin/reboot fastboot
            ;;
            8)
            sh "$START_DIR/kr-script/slot/swab.sh" -o -r
            ;;
            9)
            /system/bin/reboot
            ;;
            esac
        </handler>
    </menu>

    <group title="vivo OTA">
        <page config="ota/ota.xml" title="vivo 强制安装 OTA">
            <resource dir="file:///android_asset/kr-script/ota" />
        </page>
    </group>

    <group title="系统槽位">
        <page config="slot/slot.xml" title="A/B 槽位管理">
            <resource file="file:///android_asset/kr-script/slot/swab.sh" />
        </page>
    </group>

    <group title="vivo DSU">
        <page config="dsu/dsu.xml" title="vivo DSU 工具箱">
            <resource file="file:///android_asset/kr-script/dsu/dsu.sh" />
        </page>
    </group>

    <group title="快捷工具">
        <resource file="file:///android_asset/kr-script/wifi/wifi-pwd.sh" />
        <resource file="file:///android_asset/kr-script/verity/get_veritymode.sh" />
        <action title="打开版本测试 (*#225#)">
            <desc>快速查看手机详细版本信息：型号、软件版本号、VGC 版本、编译时间等</desc>
            <script>
                am start -a android.intent.action.DIAL -d "tel:*%23225%23"
            </script>
        </action>

        <action title="设备状态检查">
            <desc>查看当前是否已获取 Root 权限，以及 A/B 分区当前激活的槽位</desc>
            <set>sh "$START_DIR/kr-script/toolkit/device_status.sh"</set>
        </action>

        <action title="查看已保存的 WiFi 密码">
            <desc>查看本机已保存的所有 WiFi 网络及其密码（需要 Root 权限）</desc>
            <set>sh "$START_DIR/kr-script/wifi/wifi-pwd.sh"</set>
        </action>

        <action title="veritymode 状态检查">
            <desc>查看当前 veritymode（enforcing/disabled）及 LK 补丁点是否生效，DSU 修复专用（如需读取 LK 分区需 Root）</desc>
            <set>sh "$START_DIR/kr-script/verity/get_veritymode.sh"</set>
        </action>

        <action title="状态栏时间显秒切换">
            <desc>通过 settings 修改 Secure.CLOCK_SECONDS 实时切换状态栏时间是否显示秒数，无需重启（vivo / Android 11+，部分 ROM 可能需 force-stop SystemUI）</desc>
            <param name="mode" type="select" value="toggle" required="true"
                  title="操作模式" desc="选择要执行的操作">
                <option val="toggle">切换开关（默认）</option>
                <option val="on">开启显秒</option>
                <option val="off">关闭显秒</option>
                <option val="status">查看当前状态</option>
            </param>
            <set>sh "$START_DIR/kr-script/clock/toggle_clock_seconds.sh" "$mode"</set>
        </action>

        <action title="极暗模式 (Extra dim)">
            <desc>通过 settings 控制 Reduce bright colors（极暗模式）。open 跳设置页无需 root；on/off/toggle/status 需 root 或 adb shell。如需设置强度请用 `sh extra_dim.sh level &lt;0-100&gt;`（命令行）</desc>
            <param name="mode" type="select" value="open" required="true"
                  title="操作模式" desc="选择要执行的操作">
                <option val="open">跳转极暗模式设置页（无需 root）</option>
                <option val="on">开启极暗（需 root）</option>
                <option val="off">关闭极暗（需 root）</option>
                <option val="toggle">开关切换（需 root）</option>
                <option val="status">查看状态与强度</option>
            </param>
            <set>sh "$START_DIR/kr-script/toolkit/extra_dim.sh" "$mode"</set>
        </action>

        <resource file="file:///android_asset/kr-script/hidden/clear_adb_nonblocking_ffs.sh" />
        <action title="清除 adb nonblocking_ffs 残留" interruptible="false">
            <desc>清空 persist.adb.nonblocking_ffs 属性值，规避刷机属性残留检测（如小骨检测）对相关项的 FAIL/高风险报告</desc>
            <set>sh "$START_DIR/kr-script/hidden/clear_adb_nonblocking_ffs.sh"</set>
        </action>
    </group>

    <group title="vivo 电话暗码">
        <page config="secret_codes/secret_codes.xml" title="vivo 电话暗码">
            <summary>拨号盘输入工程暗码触发隐藏功能（基于本机实测）。注意：*#558# 工程页的「恢复出厂设置」会清数据并丢失 Root</summary>
        </page>
    </group>

</nav>
